{
  "functions": {
    "api/**/*.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/promotor-auth",
      "destination": "/api/promotor-auth.ts"
    },
    {
      "source": "/api/send-wa",
      "destination": "/api/send-wa.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/boleta/:ref",
      "destination": "/api/boleta?ref=:ref"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/recordatorios-cuotas",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cleanup-reservations",
      "schedule": "*/15 * * * *"
    }
  ]
}